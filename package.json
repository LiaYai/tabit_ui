{
	"name": "@tabit/ui",
	"private": true,
	"version": "0.0.0-semantic-release",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/src/index.d.ts",
	"files": [
		"dist",
		"scss"
	],
	"exports": {
		"import": "./dist/index.js",
		"scss": "./scss/index.scss"
	},
	"scripts": {
		"gen": "npx generate-react-cli",
		"dev": "vite build --watch",
		"build": "tsc -b && vite build",
		"lint": "eslint ./src",
		"format": "prettier ./src --write",
		"prepare": "git config core.hooksPath .git-hooks || echo 'Not in a git repo'",
		"test:watch": "yarn vitest --watch",
		"test": "concurrently \"yarn vitest --run --passWithNoTests\" \"yarn test-storybook:ci\"",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"test-storybook": "test-storybook",
		"storybook-server": "yarn build-storybook && http-server storybook-static --port 6006 --silent",
		"test-storybook:ci": "concurrently -k -s first -n \"SB,TEST\" -c \"green,blue\" \"yarn storybook-server\" \"wait-on tcp:127.0.0.1:6006 && yarn test-storybook\""
	},
	"peerDependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "3.2.3",
		"@commitlint/cli": "^19.6.1",
		"@commitlint/config-conventional": "^19.6.0",
		"@eslint/js": "^9.17.0",
		"@laynezh/vite-plugin-lib-assets": "^0.6.1",
		"@semantic-release/changelog": "^6.0.3",
		"@storybook/addon-essentials": "8.4.7",
		"@storybook/addon-interactions": "^8.4.7",
		"@storybook/addon-onboarding": "8.4.7",
		"@storybook/addon-viewport": "^8.4.7",
		"@storybook/blocks": "8.4.7",
		"@storybook/react": "8.4.7",
		"@storybook/react-vite": "8.4.7",
		"@storybook/test": "^8.4.7",
		"@storybook/test-runner": "^0.21.0",
		"@testing-library/dom": "^10.4.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.1.0",
		"@types/jest": "^29.5.14",
		"@types/node": "^22.10.5",
		"@types/react": "^18.3.17",
		"@types/react-dom": "^18.3.5",
		"@typescript-eslint/eslint-plugin": "^8.19.1",
		"@typescript-eslint/parser": "^8.19.1",
		"@vitejs/plugin-react": "^4.3.4",
		"@vitest/coverage-v8": "2.1.8",
		"concurrently": "^9.1.0",
		"esbuild": "0.24.0",
		"eslint": "^9.17.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-jest": "^28.10.0",
		"eslint-plugin-react": "^7.37.2",
		"eslint-plugin-react-hooks": "^5.0.0",
		"eslint-plugin-react-refresh": "^0.4.16",
		"eslint-plugin-storybook": "^0.11.1",
		"eslint-plugin-testing-library": "^7.1.1",
		"globals": "^15.13.0",
		"http-server": "^14.1.1",
		"husky": "^9.1.7",
		"jest": "^29.7.0",
		"jest-circus": "^29.7.0",
		"jest-playwright-preset": "^4.0.0",
		"jest-runner": "^29.7.0",
		"jsdom": "^26.0.0",
		"lint-staged": "^15.2.11",
		"playwright": "^1.49.1",
		"playwright-chromium": "^1.49.1",
		"prettier": "^3.4.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"sass": "^1.83.0",
		"storybook": "8.4.7",
		"translation-check": "^1.1.0",
		"typescript": "5.6.3",
		"typescript-eslint": "^8.18.1",
		"vite": "^6.0.3",
		"vite-plugin-dts": "^4.4.0",
		"vite-plugin-lib-inject-css": "^2.1.1",
		"vitest": "^2.1.8",
		"wait-on": "^8.0.1"
	},
	"resolutions": {
		"esbuild": "0.24.0"
	},
	"jest": {
		"preset": "jest-playwright-preset"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"yarn lint",
			"yarn test"
		],
		"src/**/*": "yarn format"
	},
	"packageManager": "yarn@4.5.3",
	"eslintConfig": {
		"extends": [
			"plugin:storybook/recommended"
		]
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"i18next": "^24.2.0",
		"i18next-browser-languagedetector": "^8.0.2",
		"i18next-http-backend": "^3.0.1",
		"react-i18next": "^15.2.0"
	}
}
